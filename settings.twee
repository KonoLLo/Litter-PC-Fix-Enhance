:: Setting FloatingSprite [widget]

<<widget "floatingSpriteModTab">>
	<<button "小小PC">>
		<<toggleTab>>
		<<replace #customOverlayContent>><<floatingSpriteModSetting>><</replace>>
	<</button>>
<</widget>>

<<widget "floatingSpriteModSetting">>
	<<if typeof FloatingSprite is "object">>
		<<run FloatingSprite.ensure()>>

		<div class="p-2 text-align-center">
			<h3>小小PC-修复增强</h3>
		</div>

		<div class="settingsGrid">

			<div class="settingsToggleItem" data-lpc="enabled">
				<label>
					<<checkbox "$options.litterpc.enabled" false true autocheck>>
					模型开关
				</label>
				<span class="tooltip-anchor linkBlue" tooltip="勾选后在游戏界面上显示角色模型立绘。">(?)</span>
			</div>

			<div class="settingsToggleItem" data-lpc="clickThrough">
				<label>
					<<checkbox "$options.litterpc.clickThrough" false true autocheck>>
					点击穿透
				</label>
				<span class="tooltip-anchor linkBlue" tooltip="勾选后模型整体不再阻挡点击，手指可以点到它下面的游戏按钮；代价是穿透期间拖不动小人。若万一小人压住了选项入口，先勾上它就能点到面板把它关掉，再拖走小人。与固定位置各自独立，可任意组合。">(?)</span>
			</div>

			<div class="settingsToggleItem" data-lpc="positionLocked">
				<label>
					<<checkbox "$options.litterpc.positionLocked" false true autocheck>>
					固定位置
				</label>
				<span class="tooltip-anchor linkBlue" tooltip="勾选后锁定小人位置、禁止拖拽，避免误触挪动。与点击穿透各自独立，可任意组合。">(?)</span>
			</div>

			<div class="settingsToggleItemWide">
				当前位置&nbsp;
				<span class="lpc-pos">X=<<print FloatingSprite.pos.left>>, Y=<<print FloatingSprite.pos.top>></span>
				&nbsp;&nbsp;
				<<button "重置位置">>
					<<run FloatingSprite.resetPos()>>
				<</button>>
			</div>

			<div class="settingsToggleItemWide" data-lpc="mode">
				前景背景
				<span class="tooltip-anchor linkBlue" tooltip="两种模式都会按实际画出来的内容裁掉画布四周的透明空白，浮窗大小就等于那张画面本身：显示背景时是侧栏画面，隐藏背景时是角色模型。裁边靠读像素量出来，量不到（刚进局、画布还没画）时先按原来的正方形显示。">(?)</span>
				<div class="lpc-radio-row">
					<label><<radiobutton "$options.litterpc.mode" "character" autocheck>> 隐藏背景</label>
					<label><<radiobutton "$options.litterpc.mode" "background" autocheck>> 显示背景</label>
				</div>
			</div>

			<div class="settingsToggleItemWide" data-lpc="scale">
				缩放倍率
				<span class="tooltip-anchor linkBlue" tooltip="调整显示大小，范围 50% ~ 150%。100% 就是画面自己的原始像素大小。">(?)</span>
				<div class="lpc-scale-row">
					<<numberslider "$options.litterpc.scale" $options.litterpc.scale 0.5 1.5 0.05 {
						onInputChange: value => { FloatingSprite.changed('scale'); },
						value: v => `${Math.round(v * 100)}%`
					}>>
				</div>
				<<button "重设">>
					<<run FloatingSprite.set('scale', 0.85)>>
				<</button>>
			</div>

			<div class="settingsToggleItemWide" data-lpc="clipRange">
				显示范围
				<span class="tooltip-anchor linkBlue" tooltip="双向滑条，中点是完整。往右是仅特写，从左往右裁、越往右裁得越多；往左是仅模型，从右往左裁、越往左裁得越多。数值是裁掉那一侧的百分比，0 就是完整。与秋枫白桦框架的同名设置互不影响。">(?)</span>
				<div class="lpc-scale-row">
					<<numberslider "$options.litterpc.clipRange" $options.litterpc.clipRange -100 100 1 {
						onInputChange: value => { FloatingSprite.changed('clipRange'); },
						value: v => (v > 0 ? `特写(裁左) ${v}%` : (v < 0 ? `模型(裁右) ${-v}%` : `完整`))
					}>>
				</div>
				<<button "重设">>
					<<run FloatingSprite.set('clipRange', 0)>>
				<</button>>
			</div>

			<div class="settingsToggleItemWide" data-lpc="opacity">
				透明度
				<span class="tooltip-anchor linkBlue" tooltip="调整模型的不透明度，范围 10% ~ 100%。留了 10% 的下限，全透明会让你再也找不到它。">(?)</span>
				<div class="lpc-scale-row">
					<<numberslider "$options.litterpc.opacity" $options.litterpc.opacity 0.1 1 0.05 {
						onInputChange: value => { FloatingSprite.changed('opacity'); },
						value: v => `${Math.round(v * 100)}%`
					}>>
				</div>
				<<button "重设">>
					<<run FloatingSprite.set('opacity', 1)>>
				<</button>>
			</div>

			<div class="settingsToggleItemWide">
				导出动作动图
				<span class="tooltip-anchor linkBlue" tooltip="把接下来 2 秒的画面逐帧采集成 GIF 下载。采的是当前模式正在显示的东西：隐藏背景模式采角色模型，显示背景模式采背景图（也就是侧栏画面的拷贝）。两种模式都按量出来的内容框裁掉四周的透明空白，导出大小与浮窗一致。游戏设置里开了侧边栏动画才会有动效，否则导出的是静止画面；导出与你摆的位置和透明度无关。部分手机浏览器不会自动触发下载，这时点结果那行里的保存链接或分享按钮拿文件。">(?)</span>
				<<button "导出 GIF">>
					<<run FloatingSprite.exportGif()>>
				<</button>>
				<div id="lpc-gif-status" class="lpc-gif-status"></div>
				<div id="lpc-gif-actions" class="lpc-gif-actions"></div>
			</div>

		</div>
	<<else>>
		<div class="p-2 text-align-center">
			<h3>小小PC-修复增强</h3>
			<p>未找到 FloatingSprite 脚本，请确认本模组已随 ModLoader 正常加载。</p>
		</div>
	<</if>>
<</widget>>
