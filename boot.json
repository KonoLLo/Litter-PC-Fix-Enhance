{
  "name": "小小PC-修复增强",
  "nickName": {
    "en": "Litter-PC-Fix-Enhance",
    "cn": "小小PC-修复增强"
  },
  "version": "1.02",
  "styleFileList": ["style.css"],
  "scriptFileList": ["floating_sprite.js"],
  "tweeFileList": ["settings.twee"],
  "imgFileList": [],
  "addonPlugin": [
    {
      "modName": "TweeReplacer",
      "addonName": "TweeReplacerAddon",
      "modVersion": "^1.0.0",
      "params": [
        {
          "passage": "overlayReplace",
          "findRegex": "<<optionsinformation>><<\\/replace>>[\\s\\S]*?<<\\/button>>",
          "regexFlag": "g",
          "replace": "<<optionsinformation>><</replace>>\n\t\t<</button>><<floatingSpriteModTab>>"
        }
      ]
    }
  ],
  "dependenceInfo": [
    { "modName": "ModLoader", "version": "^2.31.2" },
    { "modName": "TweeReplacer", "version": "^1.0.0" },
    { "modName": "maplebirch", "version": ">=5.0.0" }
  ]
}
